// mudra example config (KDL v2). Copy to ~/.config/mudra/config.kdl to take effect.
// Missing entries fall back to built-in defaults (frontend/shared/lib.js MudraConfig.defaults).
// The extension fetches this via GET /config at startup and re-applies it on every
// sync; only keys pinned with :set (chrome.storage.local) win over this file.

bar {
    font "12px monospace"      // status bar font
    height 16                  // status bar height px
    fg "#666666"               // dark gray by default; "auto" = black or white, picked from bg's luminance
    bg "rgba(0,0,0,.55)"       // normal mode: translucent, frosted by blur
    insertFg "auto"
    insertBg "rgba(232,232,232,.62)"
    hintFg "auto"              // hint labels: "auto" = black/white by hintBg; frosted, see hintOpacity
    hintBg "#fbf1c7"           // gruvbox light yellow
    blur 12                    // frosted-glass radius px (bar, command panel, hint labels); 0 = off
    opacity 0.1                // the strip's own alpha; the tint comes from bg
}

hint {
    chars "asdfghjkl;qwertyuiopzxcv" // character pool; assignment follows this order
    fontSize 14                // hint label font size px — read at a glance over page text
    opacity 0.45               // hint label alpha; low enough to read the page through the tint
}

command {
    bg "#fbf1c7"               // command panel hue: gruvbox light yellow
    fg "#3c3836"               // command panel text: gruvbox dark gray
    opacity 0.62               // panel alpha; lower = more frost, higher = more colour
    scrollbar 2                // candidate list scrollbar width px (thumb only, no track)
}

progress {
    height 2                   // page-load bar thickness px; 0 = no bar
    colors "#fb4934 #fe8019 #fabd2f #b8bb26 #83a598 #d3869b" // multi-stop gradient, left to right
}

sequence {
    timeout 1200               // ms a sequence opener waits for its second key (y → yy / yt)
}

keys {
    // value = command name (content.js COMMANDS); kdl-py 1.2.0 requires quoted string values.
    // ONLY what differs from the built-in layout belongs here. That layout keeps the
    // hands on the home row: e/d half page (WASD column shifted one key right), s/f
    // history back/forward, h/j/k/l one line, w/W hints, a/A the address picker
    // (o/O aliases), g/G top/bottom, r reload, t tag, P pages. A whole page and
    // "close" have no default key — bind them here when you want them:
    // u "pageUp"
    // o "pageDown"     (o is a free alias slot only if you do not want the address picker on it)
}

scroll {
    stepLines 1                 // lines per scroll key (h/j/k/l)
    overlapLines 5              // lines kept when paging a whole page (pageDown/pageUp)
}

// Placeholder: parsed but not consumed; the port is still decided by mudrad startup args
server {
    port 8899
}

ui {
    thumbnails false   // screenshot hover preview for panel link hover
    indent 1.4         // page-tree indent per nesting level, in em
}

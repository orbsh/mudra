// mudra example config (KDL v2). Copy to ~/.config/mudra/config.kdl to take effect.
// Missing entries fall back to built-in defaults (frontend/shared/lib.js MudraConfig.defaults).
// The extension fetches this via GET /config at startup and re-applies it on every
// sync; only keys pinned with :set (chrome.storage.local) win over this file.

bar {
    font "12px monospace"      // status bar font
    height 16                  // status bar height px
    fg "#666666"               // dark gray by default; "auto" = black or white, picked from bg's luminance
    bg "rgba(0,0,0,.55)"       // normal mode: translucent, frosted by blur
    insertFg "auto"
    insertBg "rgba(232,232,232,.62)"
    hintFg "auto"              // hint labels (opaque, they sit on page text)
    hintBg "#ffd76e"
    blur 12                    // frosted-glass radius px; 0 = translucency only
    opacity 0.1                // the strip's own alpha; the tint comes from bg
}

hint {
    chars "asdfghjkl;qwertyuiopzxcv" // letter pool; assignment follows this order
    fontSize 12                // hint label font size px
}

keys {
    // value = command name (content.js COMMANDS); kdl-py 1.2.0 requires quoted string values
    j "scrollDown"
    k "scrollUp"
    h "scrollLeft"
    l "scrollRight"
    w "scrollPageUp"
    s "scrollPageDown"
    gg "scrollToTop"
    G "scrollToBottom"
    f "hints"
    a "back"
    d "forward"
}

scroll {
    stepLines 3                // lines per j/k scroll
    overlapLines 5             // lines kept when paging with w/s (overlap)
}

command {
    maxCandidates 10           // max entries in the command-mode popup menu
}

// Placeholder: parsed but not consumed; the port is still decided by mudrad startup args
server {
    port 8899
}

ui {
    thumbnails false   // screenshot hover preview for panel link hover
}

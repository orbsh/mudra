{
  "manifest_version": 3,
  "name": "mudra-keys",
  "version": "0.1.1",
  "description": "mudra keyboard driving: letter hints, H/L history, qutebrowser-style status bar. Talks to mudrad (127.0.0.1:8899).",
  "background": {
    "service_worker": "/extension/sw.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8899/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "/shared/lib.js",
        "/extension/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}